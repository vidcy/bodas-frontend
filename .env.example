# URL de la API del Backend NestJS
# Para desarrollo local:
VITE_API_URL=http://localhost:3000/api

# Para producción (Vercel):
# Configura esta variable en el panel de Vercel (Project Settings > Environment Variables)
# apuntando a la URL pública que te entrega Railway:
# VITE_API_URL=https://bodas-backend-production.up.railway.app/api
